# TivuStream Privacy Intelligence Engine (PIE)
# EditorConfig
#
# Le convenzioni definite in questo file supportano i Coding Principles
# dell'AI Development Guide: leggibilita', semplicita', uniformita'.
#
# Le terminazioni di riga sono coerenti con .gitattributes.

root = true

# ---------------------------------------------------------------------------
# Regole comuni
# ---------------------------------------------------------------------------

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# ---------------------------------------------------------------------------
# Documentazione
# ---------------------------------------------------------------------------

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# Configurazione e dati
# ---------------------------------------------------------------------------

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.{xml,csproj,props,targets,resx,config}]
indent_size = 2

# ---------------------------------------------------------------------------
# Frontend - Vue 3, TypeScript, Vite
# ---------------------------------------------------------------------------

[*.{ts,tsx,js,mjs,cjs,vue,css,scss,html}]
indent_size = 2
quote_type = single

# ---------------------------------------------------------------------------
# Script
# ---------------------------------------------------------------------------

[*.sh]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.sln]
end_of_line = crlf
indent_style = tab

# ---------------------------------------------------------------------------
# Backend - C#
# ---------------------------------------------------------------------------

[*.cs]
indent_size = 4

# --- Organizzazione delle direttive using ---

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# --- Struttura del file ---

csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# --- Chiarezza rispetto alla concisione ---
# Il progetto privilegia la leggibilita' sulle soluzioni compatte.

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# --- Immutabilita' e sicurezza ---

dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion

# --- Pattern moderni supportati dal framework ---

csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# --- Qualita' del codice ---

dotnet_code_quality_unused_parameters = all:warning
csharp_style_unused_value_expression_statement_preference = discard_variable:suggestion
dotnet_remove_unnecessary_suppression_exclusions = none
dotnet_diagnostic.IDE0005.severity = warning

# ---------------------------------------------------------------------------
# Convenzioni di denominazione C#
#
# Il codice sorgente utilizza esclusivamente identificatori in lingua inglese,
# come richiesto dalla documentazione di progetto.
# ---------------------------------------------------------------------------

# Interfacce: prefisso I

dotnet_naming_rule.interfaces_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_prefixed_with_i.style = prefix_i_pascal_case

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.prefix_i_pascal_case.required_prefix = I
dotnet_naming_style.prefix_i_pascal_case.capitalization = pascal_case

# Tipi e membri pubblici: PascalCase

dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_rule.types_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_pascal_case.style = pascal_case

dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *

dotnet_naming_rule.members_pascal_case.severity = warning
dotnet_naming_rule.members_pascal_case.symbols = member_symbols
dotnet_naming_rule.members_pascal_case.style = pascal_case

dotnet_naming_symbols.member_symbols.applicable_kinds = method, property, event
dotnet_naming_symbols.member_symbols.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case

# Costanti: PascalCase

dotnet_naming_rule.constants_pascal_case.severity = warning
dotnet_naming_rule.constants_pascal_case.symbols = constant_symbols
dotnet_naming_rule.constants_pascal_case.style = pascal_case

dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.required_modifiers = const

# Campi privati: prefisso _

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = prefix_underscore_camel_case

dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private

dotnet_naming_style.prefix_underscore_camel_case.required_prefix = _
dotnet_naming_style.prefix_underscore_camel_case.capitalization = camel_case

# Parametri e variabili locali: camelCase

dotnet_naming_rule.parameters_camel_case.severity = warning
dotnet_naming_rule.parameters_camel_case.symbols = parameter_symbols
dotnet_naming_rule.parameters_camel_case.style = camel_case

dotnet_naming_symbols.parameter_symbols.applicable_kinds = parameter, local

dotnet_naming_style.camel_case.capitalization = camel_case

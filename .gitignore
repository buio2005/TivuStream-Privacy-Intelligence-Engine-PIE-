# TivuStream Privacy Intelligence Engine (PIE)
# Git Ignore
#
# Il repository conserva esclusivamente codice sorgente, documentazione
# e configurazione. Artefatti di build, dati locali e credenziali
# non vengono mai versionati.

# ---------------------------------------------------------------------------
# Backend - .NET
# ---------------------------------------------------------------------------

bin/
obj/
[Dd]ebug/
[Rr]elease/
[Bb]uild/
[Oo]ut/
artifacts/
publish/
*.dll
*.exe
*.pdb
*.cache
*.user
*.userosscache
*.suo
*.sln.docstates
project.lock.json
project.fragment.lock.json

# Test e code coverage

[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml
*.trx

# ---------------------------------------------------------------------------
# Frontend - Node, Vite
# ---------------------------------------------------------------------------

node_modules/
dist/
dist-ssr/
.vite/
.nuxt/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Database SQLite locale
#
# I database sono generati in esecuzione e contengono dati di rete
# dell'utente. Il principio Privacy First ne vieta il versionamento.
# ---------------------------------------------------------------------------

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Credenziali e configurazione locale
#
# Le credenziali delle Data Sources non devono mai raggiungere il repository.
# ---------------------------------------------------------------------------

.env
.env.*
!.env.example
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.p12
*.key
*.pem

# ---------------------------------------------------------------------------
# Ricognizione temporanea
#
# Cartella di lavoro usata per raccogliere risposte reali da una Data Source
# durante l'analisi. Contiene dati di rete e non va versionata.
# Va rimossa al termine della ricognizione.
# ---------------------------------------------------------------------------

technitium-recon/

# ---------------------------------------------------------------------------
# Log e file temporanei
# ---------------------------------------------------------------------------

logs/
*.log
*.tmp
*.bak
*.swp
*~

# ---------------------------------------------------------------------------
# Ambienti di sviluppo
# ---------------------------------------------------------------------------

.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml

# ---------------------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

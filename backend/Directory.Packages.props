<Project>

  <!--
    TivuStream Privacy Intelligence Engine (PIE)
    Central Package Management.

    Package versions are declared here once and referenced without a version
    by the individual projects.

    The documentation requires every dependency to be recorded with name,
    version, licence and purpose. Keeping all versions in a single file makes
    that record easy to review and prevents the same package from being
    referenced at different versions across projects.

  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinning>true</CentralPackageTransitivePinning>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.Data.Sqlite
      Purpose : access to the SQLite database of the Storage component
      Licence : MIT
      Approved: Documentation Release 1.0.5, Persistence Specification

      Version 10.0.0 brought in SQLitePCLRaw.lib.e_sqlite3 2.1.11, which
      carries a known vulnerability of high severity. The dependency audit
      refused the build, which is what it is there for.
    -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />

    <!--
      SQLitePCLRaw family
      Purpose : native SQLite library, reached through Microsoft.Data.Sqlite
      Licence : Apache-2.0

      None of these is referenced directly by any project.

      Every release of Microsoft.Data.Sqlite up to 10.0.10 still brings in
      2.1.11, which carries advisory GHSA-2m69-gcr7-jv3q.

      Central transitive pinning proved ineffective on this family, so the
      Storage project references the bundle directly. A direct reference
      always wins over transitive resolution.

      These entries provide the version for that reference and keep the family
      consistent.

      Series 3.x exists but is a major change that Microsoft.Data.Sqlite 10.x
      does not expect, so 2.1.12 is the correct target.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />

    <!--
      Test infrastructure
      Purpose : automated verification of the rules stated in the Specifications
      Licence : Apache-2.0 for xUnit, MIT for the test platform
      Approved: Documentation Release 1.1.0

      Referenced only by the projects under tests, never by the product.
    -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />

    <!--
      Microsoft.AspNetCore.Mvc.Testing
      Purpose : runs the real host in memory so that the endpoints can be
                verified through HTTP, which is the boundary the API exposes
      Licence : MIT
      Approved: 2026-09-19, on the proposal recorded in the changelog entry
                "Prove ai confini"

      Referenced only by the API test project, never by the product.

      Version 10.0.8 matches the ASP.NET Core runtime installed. A newer
      package would bring newer framework assemblies into the test output
      than the ones the product runs on.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />

    <!--
      Microsoft.Extensions.Hosting.WindowsServices
      Microsoft.Extensions.Hosting.Systemd
      Purpose : let the product run as a Windows service and as a systemd
                unit, reporting its state to the service manager. Outside a
                service, neither changes anything
      Licence : MIT
      Approved: 2026-09-26, Installation Specification 1.3.0, Running As A
                Service

      Version 10.0.8, as the ASP.NET Core runtime installed, for the reason
      given above.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.8" />
  </ItemGroup>

</Project>

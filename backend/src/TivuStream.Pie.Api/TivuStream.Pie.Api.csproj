<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Application host.

    Hosts the REST API layer and acts as the composition root of the system.
    Being the composition root, this is the only project allowed to reference
    a concrete Adapter.
  -->

  <PropertyGroup>
    <Description>Host of the Privacy Intelligence Engine.</Description>

    <!-- The name the person types at the terminal (Installation Specification, Package). -->
    <AssemblyName>tivustream-pie</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TivuStream.Pie.Core\TivuStream.Pie.Core.csproj" />
    <ProjectReference Include="..\TivuStream.Pie.Adapters\TivuStream.Pie.Adapters.csproj" />
    <ProjectReference Include="..\TivuStream.Pie.Adapters.Technitium\TivuStream.Pie.Adapters.Technitium.csproj" />
    <ProjectReference Include="..\TivuStream.Pie.Storage\TivuStream.Pie.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The endpoints live in the top level statements of Program.cs, whose type
      is internal. The test project runs the real host, and needs to see it.
    -->
    <InternalsVisibleTo Include="TivuStream.Pie.Api.Tests" />
  </ItemGroup>

</Project>

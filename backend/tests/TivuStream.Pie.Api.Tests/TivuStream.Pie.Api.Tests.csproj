<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verification of what the API says to whoever calls it.

    The real host runs in memory, with a database of its own and neither of
    its background services, so that no test reaches the Data Source or the
    Internet. What is exercised is the surface the interface depends on: the
    routes, the shape of the answers, and what they say when there is nothing
    to say.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      Test names are written as sentences, which reads better than the
      alternative and is the convention of the framework.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TivuStream.Pie.Api\TivuStream.Pie.Api.csproj" />
  </ItemGroup>

</Project>
